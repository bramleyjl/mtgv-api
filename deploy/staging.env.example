# Copy to ~/mtgv-staging/.env on pangolin, fill in real values, chmod 600.
# Never commit the filled-in version.

# Host binding — restricts published Docker ports to these interfaces only
# (avoids the well-known Docker-bypasses-ufw issue with 0.0.0.0 port publishing)
LAN_IP=192.168.0.102
TAILSCALE_IP=100.105.186.7

# mtgv-api
BULK_DATA_COLLECTION=cardData
TCG_CLIENT_ID=
TCG_CLIENT_SECRET=
DB_URL_STAGING=
DB_NAME_STAGING=MTGVersioner
